PORT=3000
NODE_ENV=development

# Supabase Postgres connection string.
# For Vercel/serverless, use the POOLER connection (port 6543), not the direct one.
# Find it in Supabase Dashboard → Project Settings → Database → Connection string → "Transaction" mode
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm

# Длинная случайная строка, используется для подписи JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Админ по умолчанию (создаётся при первом запуске если в БД нет ни одного пользователя)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор
